---
import BaseLayout from '../layouts/BaseLayout.astro';import ArticleCard from '../components/ArticleCard.astro';import {getCollection} from 'astro:content';const now=new Date();const posts=(await getCollection('blog',({data})=>!data.draft&&data.pubDate<=now)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="여행준비노트" description="여행 준비, 교통, 숙소, 짐싸기, 여행 앱과 서비스를 실용적으로 정리하는 여행 정보"><section class="hero"><div class="container"><div class="eyebrow">Travel Planning Guide</div><h1>떠나기 전 준비는 정확하게,<br/>여행은 더 가볍게.</h1><p>여행 준비, 교통, 숙소, 짐싸기, 여행 앱과 서비스를 실용적으로 정리하는 여행 정보를 실제 여행 준비 순서에 맞춰 정리합니다.</p></div></section><section class="section"><div class="container"><div class="eyebrow">Latest</div><h2>최근 글</h2><div class="grid">{posts.slice(0,6).map(p=><ArticleCard post={p}/>)}</div></div></section></BaseLayout>
