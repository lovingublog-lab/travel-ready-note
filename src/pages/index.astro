---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';

const now = new Date();
const posts = (await getCollection('blog', ({data}) => !data.draft && data.pubDate <= now))
  .sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest = posts.slice(0,8);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="여행 준비·숙소·교통 실용 가이드" description="여행 준비, 항공·공항, 숙소, 교통, 짐싸기, 여행 앱과 결제를 출발 전 실제 준비 순서에 맞춰 정리하는 여행 실용 정보 블로그입니다.">
  <section class="masthead">
    <div class="container masthead-inner">
      <div>
        <div class="masthead-kicker">Travel Planning Journal</div>
        <h1>여행준비노트</h1>
        <p>숙소·교통·짐싸기·여행 앱과 결제를 실제 준비 순서대로 정리한 여행 가이드</p>
      </div>
      <div class="masthead-topics" aria-label="주요 주제">여행 준비 · 숙소 · 교통 · 짐싸기 · 여행 앱</div>
    </div>
  </section>

  <section class="section latest-section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Latest Posts</div><h2>최근 글</h2></div>
        <a class="text-link" href={`${base}articles/`}>전체 글 보기 →</a>
      </div>

      <div class="post-list">
        {latest.map((post, index) => (
          <a class="post-row" href={`${base}blog/${post.slug}/`} aria-label={post.data.title}>
            <article class="post-row-inner">
              {post.data.image && (
                <div class="post-row-media">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    width="1200"
                    height="675"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                  />
                </div>
              )}
              <div class="post-row-copy">
                <div class="post-row-meta">
                  <span>{post.data.category}</span>
                  <span>{new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'long',day:'numeric'}).format(post.data.pubDate)}</span>
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
